# UG1209
#-----------------------------------------------------------------------------------------------------------------------
# Creating RSA private / Public key pairs
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [bootloader, destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}
 
> bootgen -p zu1cg -arch zynqmp -generate_keys auth pem -image key_gen.bif

#-----------------------------------------------------------------------------------------------------------------------
# Enabling Boot Header Authentication
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [fsbl_config]bh_auth_enable
  [bootloader, authentication = rsa, destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl, authentication = rsa]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3, authentication = rsa]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}



#-----------------------------------------------------------------------------------------------------------------------
# Generating Keys for Confidentiality
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [keysrc_encryption]bbram_red_key
  [fsbl_config]bh_auth_enable
  [bootloader, authentication = rsa, encryption = aes, aeskeyfile = fsbl.nky, destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl, authentication = rsa, encryption = aes, aeskeyfile = top.nky]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3, authentication = rsa, encryption = aes, aeskeyfile = helloWorld.nky]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}


#-----------------------------------------------------------------------------------------------------------------------
# Enabling DPA Protections
# Enabling Use of an Operational Key
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [keysrc_encryption]bbram_red_key
  [fsbl_config]bh_auth_enable, opt_key
  [bootloader, authentication = rsa, encryption = aes, aeskeyfile = fsbl.nky, destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl, authentication = rsa, encryption = aes, aeskeyfile = top.nky]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3, authentication = rsa, encryption = aes, aeskeyfile = helloWorld.nky]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}

#-----------------------------------------------------------------------------------------------------------------------
# Enabling Encryption Using Key Rolling
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [keysrc_encryption]bbram_red_key
  [fsbl_config]bh_auth_enable, opt_key
  [bootloader, authentication = rsa, encryption = aes, aeskeyfile = fsbl.nky, blocks = 1728(*), destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl, authentication = rsa, encryption = aes, aeskeyfile = top.nky, blocks = 1728(*)]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3, authentication = rsa, encryption = aes, aeskeyfile = helloWorld.nky, blocks = 1728(*)]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}

#-----------------------------------------------------------------------------------------------------------------------
# Generating All of the AES Keys
#-----------------------------------------------------------------------------------------------------------------------

> bootgen -p zu1cg -arch zynqmp -image key_gen.bif

#-----------------------------------------------------------------------------------------------------------------------
# PUF Registration in Boot Header Mode
# Using PUF in Boot Header Mode
#-----------------------------------------------------------------------------------------------------------------------
the_ROM_image:
{
  [pskfile]psk0.pem
  [sskfile]ssk0.pem
  [auth_params]spk_id = 0; ppk_select = 0
  [keysrc_encryption]bh_blk_key
  [bh_key_iv]black_iv.txt
  [bh_keyfile]black_key.txt
  [puf_file]helperdata.txt
  [fsbl_config]bh_auth_enable, opt_key, puf4kmode, shutter=0x0100005E,pufhd_bh
  [bootloader, authentication = rsa, encryption = aes, aeskeyfile = fsbl.nky, blocks = 1728(*), destination_cpu = a53-0]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/platform/export/platform/sw/boot/fsbl.elf
  [destination_device = pl, authentication = rsa, encryption = aes, aeskeyfile = top.nky, blocks = 1728(*)]/mnt/TDG_512/projects/7_zub/output_products/bit/top.bit
  [destination_cpu = a53-0, exception_level = el-3, authentication = rsa, encryption = aes, aeskeyfile = helloWorld.nky, blocks = 1728(*)]/mnt/TDG_512/projects/7_zub/sub/sw/work_sec/helloWorld/build/helloWorld.elf
}

> bootgen -p zu1cg -arch zynqmp -image key_gen.bif -w on -o BOOT.bin

